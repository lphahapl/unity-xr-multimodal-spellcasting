+                     "source_elapsed_seconds": (begin-offset)/sr, "count": actual.size,
+                     "source_energy": float(np.sum(reference*reference)),
+                     "capture_energy": float(np.sum(actual*actual)), "dot": float(np.sum(actual*reference))})
+    return rows
+
