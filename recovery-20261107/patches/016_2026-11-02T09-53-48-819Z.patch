+using System;
+using System.Reflection;
+using NarutoVR.SealCombat.Rpg;
+using UnityEngine;
+
+namespace NarutoVR.SealCombat.Editor
+{
+    public static class P1AudioChecks
+    {
+        // Exercises the existing UDP packet parser directly without binding the live port or opening the microphone.
+        [Serializable] sealed class Packet
+        {
+            public int v = 1, nonce;
+            public string kind = "pong", session = "p1-audio-check", mode = "microphone";
+            public bool ready = true;
+            public double client_send, server_recv, server_send;
+            public int audio_telemetry_version = 1;
+            public long audio_frames = 20, audio_voiced_frames = 4;
+            public double audio_snapshot_at, audio_age = .02, audio_voice_age = .04, audio_rms = .05, audio_peak = .2, audio_energy_threshold = .012;
+        }
+        public static int Run()
+        {
+            int checks = 0;
+            void Check(bool condition, string description)
+            {
+                if (!condition) throw new InvalidOperationException("P1 音频检查失败：" + description);
+                ++checks;
+            }
+            float blend = P1AudioManager.MoveMix(0,true,.3f,1.2f);
+            Check(Mathf.Abs(blend-.25f)<.001f, "进入战斗平滑交叉淡化");
+            Check(P1AudioManager.MoveMix(blend,false,.1f,1.2f) is > 0 and < .25f, "反向切换保持连续");
+            float low = P1AudioManager.MoveDuck(1,true,1,-8,.06f,.4f);
+            Check(Mathf.Abs(low-.398107f)<.001f, "负8分贝的线性增益");
+            float restored = P1AudioManager.MoveDuck(low,false,.1f,-8,.06f,.4f);
+            Check(restored>low && restored<1 && P1AudioManager.MoveDuck(restored,false,1,-8,.06f,.4f)==1, "音量逐步恢复");
+            Check(P1AudioManager.MoveDuck(low,true,.02f,0,.06f,.4f)==1, "关闭衰减后恢复基准音量");
+
+            var go = new GameObject("P1 音频遥测隔离检查"){ hideFlags=HideFlags.HideAndDontSave };
+            go.SetActive(false);
+            try
+            {
+                var receiver = go.AddComponent<SkillVoiceReceiver>();
+                var type = typeof(SkillVoiceReceiver);
+                var parsedType = type.GetNestedType("Packet",BindingFlags.NonPublic);
+                var process = type.GetMethod("Process",BindingFlags.Instance|BindingFlags.NonPublic);
+                var pingSent = type.GetField("pingSent",BindingFlags.Instance|BindingFlags.NonPublic);
+                var packet = new Packet();
+                bool Send(double age = 0)
+                {
+                    double now = Time.realtimeSinceStartupAsDouble;
+                    packet.client_send = packet.server_recv = packet.server_send = now;
+                    pingSent.SetValue(receiver,now);
+                    packet.audio_snapshot_at = now-age;
+                    process.Invoke(receiver,new[]{JsonUtility.FromJson(JsonUtility.ToJson(packet),parsedType),(object)now});
+                    return receiver.HasRecentMicrophoneSpeech();
+                }
+                Check(Send(), "新鲜真实麦克风有声帧触发");
+                Check(!Send(2), "迟到的已缓冲心跳不会触发");
+                packet.audio_voice_age=.8; Check(!Send(), "静音恢复");
+                packet.audio_voice_age=.01; packet.audio_age=1.1; Check(!Send(), "采样停止恢复");
+                packet.audio_age=.01; packet.mode="wav-replay"; Check(!Send(), "回放不触发");
+                packet.mode="protocol-test"; Check(!Send(), "模拟口令不触发");
+                packet.mode="microphone"; packet.ready=false; Check(!Send(), "未就绪恢复");
+                packet.ready=true; packet.audio_voiced_frames=0; Check(!Send(), "无有声帧不触发");
+            }
+            finally { UnityEngine.Object.DestroyImmediate(go); }
+            return checks;
+        }
+    }
+}
