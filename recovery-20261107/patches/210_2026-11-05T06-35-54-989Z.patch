+using NarutoVR.SealCombat.Events;
+using UnityEngine;
+
+namespace NarutoVR.SealCombat
+{
+    /// <summary>把Inspector中的即时UnityEvent转为事件中心通知。延迟任务使用控制器捕获的步骤令牌。</summary>
+    public sealed class NarrationOperationPublisher : MonoBehaviour
+    {
+        [Header("操作完成通知")]
+        [InspectorName("操作标识")] public string operationId;
+        [InspectorName("目标对话（空则广播）")] public NarrationController target;
+        public void Publish()
+        {
+            if (!isActiveAndEnabled || string.IsNullOrWhiteSpace(operationId)) return;
+            NarrationEvents.PublishOperation(operationId, target);
+        }
+    }
+}
