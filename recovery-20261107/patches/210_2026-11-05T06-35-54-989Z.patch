+using UnityEngine;
+
+namespace NarutoVR.SealCombat
+{
+    /// <summary>绑定本句开始事件。计时只归属于开始时的步骤，不能推进重启后的新句。</summary>
+    [DisallowMultipleComponent]
+    public sealed class NarrationOperationTimer : MonoBehaviour
+    {
+        [Header("一、等待时间与目标")]
+        [InspectorName("对话控制器")] public NarrationController controller;
+        [InspectorName("等待秒数"), Min(0)] public float seconds = 1;
+        [InspectorName("使用真实时间（不受游戏时间缩放影响）")] public bool useUnscaledTime = true;
+        public bool IsRunning { get; private set; }
+        public float RemainingSeconds { get; private set; }
+        public string Status { get; private set; } = "未开始";
+        NarrationController capturedController;
+        long capturedToken;
+        bool unscaled;
+
+        public void Begin()
+        {
+            Cancel();
+            if (!isActiveAndEnabled || !controller || controller.CurrentStepToken == 0)
+            { Status = "未启动：没有正在等待的对话句"; return; }
+            if (!float.IsFinite(seconds) || seconds < 0)
+            { Status = "未启动：秒数必须为有限非负数"; return; }
+            capturedController = controller; capturedToken = controller.CurrentStepToken;
+            RemainingSeconds = seconds; unscaled = useUnscaledTime; IsRunning = true;
+            Status = "计时中";
+        }
+        public void Cancel()
+        {
+            IsRunning = false; RemainingSeconds = 0; capturedController = null; capturedToken = 0;
+            Status = "计时已取消";
+        }
+        void OnDisable() => Cancel();
+        void Update()
+        {
+            if (!IsRunning) return;
+            if (!capturedController || !capturedController.isActiveAndEnabled || capturedController.CurrentStepToken != capturedToken)
+            { Cancel(); Status = "原步骤已结束，计时作废"; return; }
+            RemainingSeconds = Mathf.Max(0, RemainingSeconds - (unscaled ? Time.unscaledDeltaTime : Time.deltaTime));
+            if (RemainingSeconds > 0) return;
+            var target = capturedController; long token = capturedToken;
+            Cancel();
+            Status = target.CompleteOperation(token) ? "计时完成，已提交操作信号" : "计时完成，操作已完成或本句无需操作";
+        }
+    }
+}
