+"""Phrase-level performance of recorded held dizi notes (not recorded legato).
+
+Pitch changes crossfade for 24ms; one attack/breath release belongs to a phrase.
+Continuous expression connects the notes without adding synthetic vibrato/glides.
+"""
+import numpy as np
+from scipy.interpolate import PchipInterpolator
+from scipy import signal
+import render_yicun_shanhe_pedalboard_v9 as previous
+from render_yicun_shanhe_shape_v8 import render_raw as render_other_instruments
+
+SR = previous.SR
+TRANSITION = .024
+THEME = [72, 74, 79, 76, 74, 72]
+RHYTHM = [0, 1.25, 2.0, 4.25, 5.75, 6.75]
+
+
+def build_score():
+    score, old_phrases = previous.build_score()
+    score['dizi'] = []
+    # The first thematic statement now belongs to the wind. Guzheng makes room.
+    score['guzheng'] = [e for e in score['guzheng'] if not 8 <= e[0] < 16]
+    score['guzheng'] += [(11.8, 60, 1.05, .22, 'support'),
+                         (14.6, 60, .65, .18, 'support')]
+    # Avoid sustained same-register second with the newly connected low answer.
+    score['guzheng'] = [(t, 60 if 26 < t < 27 else p, d, v, role)
+                        for t,p,d,v,role in score['guzheng']]
+    phrases = [p for p in old_phrases if p['instrument'] != 'dizi' and p['start'] != 8]
+
+    def phrase(start, pitches, offsets, length, levels, label, operation):
+        assert len(pitches) == len(offsets) == len(levels)
+        durations = np.diff(offsets + [length]).tolist()
+        item = dict(instrument='dizi', start=start, end=start+length,
+                    pitches=pitches, offsets=offsets, durations=durations,
+                    levels=levels, label=label, development=operation,
+                    transition_seconds=TRANSITION, attack_seconds=.075,
+                    final_release_seconds=.24)
+        phrases.append(item)
+        for p,o,d,v in zip(pitches,offsets,durations,levels):
+            score['dizi'].append((start+o,p,d,v,label))
+
+    # Establish the complete melody twice before developing it. Same rhythm is intentional.
+    phrase(8.25, THEME, RHYTHM, 7.35, [.49,.54,.67,.59,.51,.45],
+           'theme_statement', 'repeat')
+    phrase(16.25, THEME, RHYTHM, 7.35, [.52,.57,.70,.61,.53,.46],
+           'theme_confirmation', 'repeat')
+    phrase(24.25, [67,69,74,72,69,67], RHYTHM, 7.35, [.48,.53,.64,.57,.49,.43],
+           'lower_register_answer', 'sequence')
+    phrase(32.25, [72,74,79,76,74,72,69], [0,1.25,2,4.25,5.25,6,6.65], 7.35,
+           [.48,.53,.64,.56,.49,.44,.38], 'theme_with_descending_tail', 'vary')
+    # A complete small response, not three unrelated calls scattered over eight seconds.
+    phrase(49.0, [67,69,67], [0,1.35,2.5], 4.20, [.32,.38,.29],
+           'quiet_connected_response', 'fragment')
+    phrase(56.25, THEME, RHYTHM, 7.35, [.55,.61,.74,.64,.55,.48],
+           'theme_returns', 'recap')
+    phrase(64.25, [72,74,79,76,79,76,74,72], [0,1.25,2,3.5,4.25,5,6,6.75], 7.35,
+           [.56,.62,.75,.65,.71,.62,.54,.47], 'theme_opens_then_returns', 'vary')
+    phrase(72.5, [74,72,69,67], [0,1.60,3.25,5.35], 6.85,
+           [.52,.49,.43,.36], 'descending_resolution', 'contract')
+    phrase(88.25, THEME, RHYTHM, 7.35, [.46,.51,.62,.54,.47,.40],
+           'final_theme_recollection', 'recap')
+    phrase(96.5, [76,74,72], [0,2.10,3.95], 6.20, [.39,.35,.28],
+           'closing_three_two_one', 'fragment')
+    score = {k:sorted(v) for k,v in score.items()}
+    return score, sorted(phrases, key=lambda p:p['start'])
