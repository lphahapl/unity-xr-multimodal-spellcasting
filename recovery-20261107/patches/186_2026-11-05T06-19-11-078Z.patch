+def render_raw(score, duration, banks, seed, damp_all=True):
+    other = {k:v for k,v in score.items() if k != 'dizi'}
+    stems, details, _ = render_other_instruments(other,duration,banks,seed,damp_all)
+    rng = np.random.default_rng(seed)
+    wind = np.zeros((duration*SR,2))
+    _, phrases = build_score()
+    for phrase in phrases:
+        if phrase['instrument'] != 'dizi':
+            continue
+        mono, notes = render_phrase(banks[2],phrase,rng)
+        start = round(phrase['start']*SR)
+        wind[start:start+len(mono)] += mono[:,None]*np.array([.66,.75])
+        details += notes
+    stems['dizi'] = wind
+    return stems,details,rng
