+def render_phrase(bank, spec, rng):
+    length = spec['end']-spec['start']
+    n = round(length*SR)
+    result = np.zeros(n)
+    half = round(TRANSITION*SR/2)
+    bounds = [round(o*SR) for o in spec['offsets']] + [n]
+    details = []
+    for i, (pitch, left, right) in enumerate(zip(spec['pitches'], bounds[:-1], bounds[1:])):
+        lo = max(0,left-(half if i else 0))
+        hi = min(n,right+(half if i < len(bounds)-2 else 0))
+        sample, f0 = bank[pitch]
+        ratio = (440*2**((pitch-69)/12))/f0
+        source_start = rng.uniform(.45,1.15)*SR
+        positions = source_start + np.arange(hi-lo)*ratio
+        assert positions[-1] < len(sample)
+        note = np.interp(positions,np.arange(len(sample)),sample)
+        window = np.ones(hi-lo)
+        if i:
+            window[:2*half] = np.sin(np.linspace(0,np.pi/2,2*half))
+        if i < len(bounds)-2:
+            window[-2*half:] = np.cos(np.linspace(0,np.pi/2,2*half))
+        result[lo:hi] += note*window
+        details.append(dict(instrument='dizi', onset=spec['start']+lo/SR,
+                            nominal_onset=spec['start']+left/SR, pitch=pitch,
+                            duration_seconds=(hi-lo)/SR, velocity=spec['levels'][i],
+                            role=spec['label'], source_start_seconds=source_start/SR,
+                            source_frequency=f0, overlap_is_intentional=bool(i),
+                            expression='continuous phrase envelope, not discrete note velocity'))
+    t = np.arange(n)/SR
+    # Levels are control points across the whole phrase, with no note-by-note reset.
+    mids = [(a+b)/2/SR for a,b in zip(bounds[:-1],bounds[1:])]
+    expression = PchipInterpolator([0]+mids+[length],
+                                  [spec['levels'][0]*.92]+spec['levels']+[spec['levels'][-1]*.88])(t)
+    attack = np.sin(np.clip(t/spec['attack_seconds'],0,1)*np.pi/2)**2
+    release = np.sin(np.clip((length-t)/spec['final_release_seconds'],0,1)*np.pi/2)**2
+    result *= expression*attack*release
+    # Filter a complete phrase so state is not restarted at every pitch change.
+    result = signal.sosfilt(signal.butter(2,5200,fs=SR,output='sos'),result)
+    return result, details
+
