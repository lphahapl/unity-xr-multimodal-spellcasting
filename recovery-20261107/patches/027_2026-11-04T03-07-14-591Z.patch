*** Begin Patch
*** Add File: D:/UnityProjects/NarutoVR/Logs/skill-organization-20261104/organize.ps1
+$ErrorActionPreference = 'Stop'
+$project = (Resolve-Path -LiteralPath 'D:/UnityProjects/NarutoVR').Path
+$runtime = Join-Path $project 'Assets/SealCombat/Runtime'
+$mapping = [System.Collections.Generic.List[object]]::new()
+
+function Move-TrackedAsset([string]$source, [string]$destination) {
+    $resolved = (Resolve-Path -LiteralPath $source).Path
+    $target = [IO.Path]::GetFullPath($destination)
+    $allowed = Join-Path $project 'Assets/SealCombat'
+    if (!$resolved.StartsWith($allowed + [IO.Path]::DirectorySeparatorChar) -or !$target.StartsWith($allowed + [IO.Path]::DirectorySeparatorChar)) {
+        throw "Asset path escaped the task area."
+    }
+    if (Test-Path -LiteralPath $target) { throw "Destination exists: $target" }
+    if (!(Test-Path -LiteralPath ($resolved + '.meta'))) { throw "Missing meta: $resolved" }
+    $old = $resolved.Substring($project.Length + 1).Replace('\','/')
+    $new = $target.Substring($project.Length + 1).Replace('\','/')
+    Move-Item -LiteralPath $resolved -Destination $target
+    Move-Item -LiteralPath ($resolved + '.meta') -Destination ($target + '.meta')
+    $mapping.Add([pscustomobject]@{before=$old; after=$new})
+}
+
+New-Item -ItemType Directory -Path (Join-Path $runtime 'Skills') | Out-Null
+foreach ($folder in @('Core','Effects','Visuals')) {
+    Move-TrackedAsset (Join-Path $runtime $folder) (Join-Path $runtime ('Skills/' + $folder))
+}
+New-Item -ItemType Directory -Path (Join-Path $runtime 'Skills/Voice') | Out-Null
+Move-TrackedAsset (Join-Path $runtime 'Voice/SkillVoiceReceiver.cs') (Join-Path $runtime 'Skills/Voice/SkillVoiceReceiver.cs')
+foreach ($file in @('SkillTestController.cs','SkillTestView.cs','SkillScenario.cs')) {
+    Move-TrackedAsset (Join-Path $runtime $file) (Join-Path $runtime ('Skills/' + $file))
+}
+
+$editor = Join-Path $project 'Assets/SealCombat/Editor/Skills'
+foreach ($folder in @('Checks','Setup','Tools')) { New-Item -ItemType Directory -Path (Join-Path $editor $folder) | Out-Null }
+foreach ($file in Get-ChildItem -LiteralPath $editor -File -Filter '*.cs') {
+    $folder = if ($file.BaseName.EndsWith('Checks')) { 'Checks' } elseif ($file.BaseName.EndsWith('Setup') -or $file.BaseName -eq 'SkillVisualAssets') { 'Setup' } else { 'Tools' }
+    Move-TrackedAsset $file.FullName (Join-Path $editor ($folder + '/' + $file.Name))
+}
+$mapping | ConvertTo-Json | Set-Content -Encoding UTF8 -LiteralPath (Join-Path $project 'Logs/skill-organization-20261104/moves.json')
*** End Patch
