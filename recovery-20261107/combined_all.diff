+#if UNITY_EDITOR
+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using NarutoVR.SealCombat.Rpg;
+using NarutoVR.SealLab;
+using UnityEngine;
+using UnityEngine.XR;
+using Object = UnityEngine.Object;
+
+namespace NarutoVR.SealCombat.Editor
+{
+    public static class P1HapticChecks
+    {
+        sealed class FakeOutput : IControllerImpulseOutput
+        {
+            public readonly List<(bool left, float amplitude, float seconds)> attempts = new();
+            public int stops;
+            public bool supported = true, fail;
+            public bool TryPulse(bool left, float amplitude, float seconds, out string reason)
+            {
+                attempts.Add((left, amplitude, seconds)); reason = "设备不支持";
+                if (fail) throw new InvalidOperationException("模拟断连");
+                return supported;
+            }
+            public void Stop(bool left) => stops++;
+        }
+
+        public static int Run()
+        {
+            int count = 0;
+            void Check(bool passed, string message) { if (!passed) throw new Exception("手柄触觉检查：" + message); count++; }
+            var flags = InputDeviceCharacteristics.Controller | InputDeviceCharacteristics.HeldInHand | InputDeviceCharacteristics.Left;
+            Check(XrControllerImpulseOutput.Eligible(flags, true, true, true, 1, false, .5f), "已跟踪且主动握持的正确侧物理手柄应允许输出");
+            Check(!XrControllerImpulseOutput.Eligible(flags | InputDeviceCharacteristics.HandTracking, true, true, true, 1, true, 1) &&
+                !XrControllerImpulseOutput.Eligible(flags, false, true, true, 1, true, 1), "手追踪模拟设备与方向不符不能输出");
+            Check(!XrControllerImpulseOutput.Eligible(flags, true, false, true, 1, true, 1) &&
+                !XrControllerImpulseOutput.Eligible(flags, true, true, false, 0, true, 1) &&
+                !XrControllerImpulseOutput.Eligible(flags, true, true, true, 0, true, 1) &&
+                !XrControllerImpulseOutput.Eligible(flags, true, true, true, 1, false, 0), "桌面闲置、无追踪或无通道不能输出");
+            var hand = new HandSnapshot { connected = true, tracked = true, fresh = true, observedAt = 2 };
+            Check(HapticFeedbackService.FreshHand(hand, 2.03, .12) && !HapticFeedbackService.FreshHand(hand, 2.2, .12) &&
+                !HapticFeedbackService.FreshHand(hand, 1, .12), "仅同一时钟下的新鲜手骨骼触发裸手抑制");
+
+            var sink = new FakeOutput(); bool bare = true;
+            var driver = new ControllerPulseDriver(sink, _ => bare);
+            Check(!driver.Pulse(ControllerPulse.WristTap, true, 1, 1) && sink.attempts.Count == 0,
+                "已识别裸手不能向物理设备尝试发送");
+            bare = false;
+            Check(driver.Pulse(ControllerPulse.WristTap, true, 1, 1.01) && sink.attempts[0].left &&
+                sink.attempts[0].amplitude > 0 && sink.attempts[0].seconds <= .08f, "点腕应发出有限左手脉冲");
+            Check(!driver.Pulse(ControllerPulse.WristTap, true, 1, 1.02) && driver.Pulse(ControllerPulse.ShieldImpact, false, 1, 1.02),
+                "同侧脉冲节流独立于另一侧");
+            driver.Tick(1.2, 0, false, false, 1);
+            Check(sink.stops == 2, "到期停止自己发出的两侧脉冲");
+            sink.supported = false;
+            Check(!driver.Pulse(ControllerPulse.Launch, false, 1, 1.3) && driver.SentCount == 2, "不支持硬件不增加成功计数");
+            sink.supported = true; sink.fail = true;
+            Check(!driver.Pulse(ControllerPulse.Launch, false, 1, 1.4), "断连异常不应影响施法"); sink.fail = false;
+
+            int initial = sink.attempts.Count;
+            driver.Tick(2, 11, false, true, 1);
+            for (int i = 1; i < 20; i++) driver.Tick(2 + i * .4, 11, false, true, 1);
+            Check(sink.attempts.Count - initial == 6, "同一持有火球最多六次微震，长帧不补发");
+            driver.Tick(10, 12, true, true, 1); driver.Tick(10.25, 12, true, true, 1);
+            Check(sink.attempts[^1].left && driver.Pulse(ControllerPulse.Launch, true, 1, 10.26), "新火球可重新计数且松手优先于微震");
+            int previous = driver.SentCount; driver.Tick(10.3, 0, false, false, 1); driver.Tick(12, 0, false, false, 1);
+            Check(driver.SentCount == previous && !driver.Pulse(ControllerPulse.Dodge, false, 1, double.NaN), "清除持球和无效时钟不应补发");
+            driver.Reset();
+            CheckShieldEvent(Check);
+            return count;
+        }
+
+        static void CheckShieldEvent(Action<bool,string> check)
+        {
+            var go = new GameObject("P1触觉_护盾事件") { hideFlags = HideFlags.HideAndDontSave };
+            try
+            {
+                var effects = go.AddComponent<SkillEffects>(); effects.GameClock = () => 10;
+                float total = 0; int calls = 0;
+                effects.ShieldImpact += absorbed => { total += absorbed; calls++; };
+                check(effects.AbsorbDamage(4) == 4 && calls == 0, "无护盾的普通受伤不发护盾事件");
+                typeof(SkillEffects).GetField("buffExpiresAt",BindingFlags.Instance|BindingFlags.NonPublic).SetValue(effects, 20d);
+                typeof(SkillEffects).GetField("shieldPoints",BindingFlags.Instance|BindingFlags.NonPublic).SetValue(effects, 5f);
+                check(effects.AbsorbDamage(3) == 0 && effects.AbsorbDamage(6) == 4 && calls == 2 && total == 5,
+                    "真实吸收和击破各触发一次，回报实际吸收且保留溢出伤害");
+            }
+            finally { Object.DestroyImmediate(go); }
+        }
+    }
+}
