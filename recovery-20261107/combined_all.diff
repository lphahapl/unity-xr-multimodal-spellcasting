+"""Independent, read-only v11 PCM/transition audit. Requires the frozen SHA argument."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from datetime import datetime
+import numpy as np
+import soundfile as sf
+from pedalboard import Pedalboard, HighpassFilter, LowpassFilter, Reverb
+
+ROOT = Path(__file__).resolve().parents[2]
+LOG = Path(__file__).resolve().parent
+OLD = ROOT / "Logs/yicun-shanhe-phrased-v10"
+ANALYZER = Path.home() / ".codex/skills/music-production/scripts/analyze_audio.py"
+NAMES = ("guzheng", "dizi", "viola", "shared_room_return")
+REGIONS = ((40, 49), (53.2, 56.25), (79, 80.25), (87.74, 88.25))
+
+
+def sha(p):
+    return hashlib.sha256(p.read_bytes()).hexdigest()
+
+
+def rms(a):
+    return float(np.sqrt(np.mean(a*a)))
+
+
+def db(a):
+    return float(20*np.log10(a)) if a > 0 else None
+
+
+def mono(a):
+    return {"mono_minus_stereo_rms_db": db(rms(a.mean(axis=1))/rms(a)) if rms(a) else None,
+            "left_right_correlation": float(np.corrcoef(a.T)[0, 1]) if np.std(a[:, 0])*np.std(a[:, 1]) else None}
+
+
+def spans(mask, rate, offset=0):
+    changes = np.diff(np.r_[False, mask, False].astype(np.int8))
+    return [{"start": offset+int(s)/rate, "end": offset+int(e)/rate, "seconds": int(e-s)/rate}
+            for s, e in zip(np.flatnonzero(changes == 1), np.flatnonzero(changes == -1))]
+
+
+def at(a, start, end, sr):
+    return a[round(start*sr):round(end*sr)]
+
+
+def region_stats(master, dry, start, end, sr):
+    windows = []
+    for begin in np.arange(start, end-1e-8, .25):
+        finish = min(begin+.25, end)
+        levels = {k: db(rms(at(v, begin, finish, sr))) for k, v in dry.items()}
+        windows.append({"start": float(begin), "end": float(finish),
+                        "master_rms_dbfs": db(rms(at(master, begin, finish, sr))), "dry_rms_dbfs": levels})
+    zero = np.ones(round(end*sr)-round(start*sr), dtype=bool)
+    for data in dry.values():
+        zero &= np.all(at(data, start, end, sr) == 0, axis=1)
+    silent = spans(zero, sr, start)
+    quiet = {}
+    for threshold in (-50, -55, -60):
+        runs = spans(np.array([w["master_rms_dbfs"] is None or w["master_rms_dbfs"] < threshold for w in windows]), 4, start)
+        for run in runs:
+            run["end"] = min(run["end"], end)
+            run["seconds"] = run["end"]-run["start"]
+        quiet[str(threshold)] = {"total_seconds": sum(r["seconds"] for r in runs),
+                                 "longest_seconds": max((r["seconds"] for r in runs), default=0), "runs": runs}
+    return {"rms_dbfs": db(rms(at(master, start, end, sr))), "windows": windows,
+            "exact_all_dry_silence_total_seconds": sum(s["seconds"] for s in silent),
+            "exact_all_dry_silence_longest_seconds": max((s["seconds"] for s in silent), default=0),
+            "exact_all_dry_silence_intervals_over_20ms": [s for s in silent if s["seconds"] >= .02],
+            "near_quiet_screening": quiet}
+
+
+def entry(master, time, sr):
+    before, after = db(rms(at(master, time-.5, time, sr))), db(rms(at(master, time, time+.5, sr)))
+    return {"time": time, "before_half_second_rms_dbfs": before, "after_half_second_rms_dbfs": after,
+            "rise_db": after-before if before is not None and after is not None else None}
+
+
+def main():
+    if len(sys.argv) != 2 or len(sys.argv[1]) != 64:
+        raise SystemExit("Usage: qa_signal.py FROZEN_MASTER_SHA256")
+    expected = sys.argv[1]
+    wav = LOG / "yicun_shanhe_continuity_v11.wav"
+    assert sha(wav) == expected, "Candidate is not the frozen master"
+    source_paths = [wav, LOG/"render.json", LOG/"sections.json", LOG/"yicun_shanhe_v11_editable.mid"]
+    source_paths += [LOG/(f"dry_{n}.wav" if n != "shared_room_return" else f"{n}.wav") for n in NAMES]
+    hashes = {str(p): sha(p) for p in source_paths}
+    render = json.loads((LOG/"render.json").read_text(encoding="utf-8-sig"))
+    previous = json.loads((OLD/"render.json").read_text(encoding="utf-8-sig"))
+    command = [sys.executable, "-B", str(ANALYZER), str(wav), "--out", str(LOG/"audio-review.json"),
+               "--sections", str(LOG/"sections.json"), "--loop"]
+    if not (LOG/"audio-review.json").exists():
+        done = subprocess.run(command, capture_output=True, text=True, encoding="utf-8",
+                              env=os.environ | {"PYTHONUTF8": "1", "PYTHONDONTWRITEBYTECODE": "1"})
+        if done.returncode:
+            raise RuntimeError(done.stderr)
+    report = json.loads((LOG/"audio-review.json").read_text(encoding="utf-8"))
+    assert report["audio"]["sha256"] == expected, "Analyzer output is stale"
+    master, sr = sf.read(wav, always_2d=True)
+    old_master, old_rate = sf.read(OLD/"yicun_shanhe_phrased_v10.wav", always_2d=True)
+    assert old_rate == sr and old_master.shape == master.shape
+    stems, old_stems, stem_stats = {}, {}, {}
+    checks = {"frozen_hash_matches_render": expected == render["wav_sha256"],
+              "112_seconds_44100_stereo": master.shape == (112*44100, 2) and sr == 44100,
+              "master_finite_unclipped": bool(np.isfinite(master).all() and np.abs(master).max() < 1),
+              "pcm16_master": sf.info(wav).subtype == "PCM_16"}
+    for name in NAMES:
+        filename = f"dry_{name}.wav" if name != "shared_room_return" else f"{name}.wav"
+        data, rate = sf.read(LOG/filename, always_2d=True)
+        checks[name+"_finite_aligned_unclipped"] = bool(rate == sr and data.shape == master.shape and np.isfinite(data).all() and np.abs(data).max() < 1)
+        stems[name] = data
+        stem_stats[name] = {"rms_dbfs": db(rms(data)), "peak_dbfs": db(float(np.max(np.abs(data)))), **mono(data)}
+        if name != "shared_room_return":
+            old_stems[name], _ = sf.read(OLD/filename, always_2d=True)
+    summed = sum(stems.values())
+    error = master-summed
+    tolerance = 1/32768+4/8388608+5e-8
+    reconstruction = {"max_abs_error": float(np.abs(error).max()), "rms_error_dbfs": db(rms(error)),
+                      "tolerance": tolerance, "definition": "Four PCM24 components versus PCM16 master including float32 quantization."}
+    checks["dry_plus_room_reconstructs_master"] = reconstruction["max_abs_error"] <= tolerance
+    checks["source_hashes_match"] = all(sha(ROOT/s["path"]) == s["sha256"] for s in render["sources"])
+    checks["code_hashes_match"] = all(sha(ROOT/s["path"]) == s["sha256"] for s in render["code"])
+    checks["midi_hash_matches"] = sha(LOG/"yicun_shanhe_v11_editable.mid") == render["midi_sha256"]
+    checks["source_clean_mapping_calibration_unchanged"] = all(render[k] == previous[k] for k in ("guzheng_mapping", "fixed_source_calibration"))
+    room = render["pedalboard_room"]
+    checks["shared_room_settings_unchanged"] = all(room[k] == previous["pedalboard_room"][k] for k in ("parameters", "sends", "highpass_hz", "lowpass_hz"))
+    send = sum(np.asarray(stems[n]/render["global_gain"], dtype=np.float32)*room["sends"][n] for n in old_stems)
+    board = Pedalboard([HighpassFilter(cutoff_frequency_hz=room["highpass_hz"]), Reverb(**room["parameters"]),
+                       LowpassFilter(cutoff_frequency_hz=room["lowpass_hz"])])
+    prior, convergence = None, []
+    for cycle in range(1, 5):
+        wet = board(np.ascontiguousarray(send.T), sr, buffer_size=8192, reset=(cycle == 1)).T.copy()
+        if prior is not None:
+            delta = wet-prior
+            convergence.append({"cycle": cycle, "peak_difference": float(np.abs(delta).max()), "rms_difference": rms(delta)})
+            if convergence[-1]["peak_difference"] < 2e-7:
+                break
+        prior = wet
+    wet_error = wet*render["global_gain"]-stems["shared_room_return"]
+    room_recheck = {"convergence": convergence, "recorded_room_reproduction_peak_error": float(np.abs(wet_error).max()),
+                    "recorded_room_reproduction_rms_error_dbfs": db(rms(wet_error)),
+                    "limitation": "Independent effect replay starts from quantized PCM24 dry stems divided by master gain; it cannot recover the exact pre-export float samples."}
+    checks["periodic_room_independently_converges"] = convergence[-1]["peak_difference"] < 2e-7
+    checks["recorded_room_reproduces_within_1e_minus5"] = room_recheck["recorded_room_reproduction_peak_error"] < 1e-5
+    dry = {n: stems[n] for n in old_stems}
+    regions = [{"start": s, "end": e, "v10": region_stats(old_master, old_stems, s, e, sr),
+                "v11": region_stats(master, dry, s, e, sr)} for s, e in REGIONS]
+    entrances = [{"v10": entry(old_master, t, sr), "v11": entry(master, t, sr)} for t in (40.809459, 43.044331, 45.088614, 47.101799, 49, 56.25, 80.238359, 88.25)]
+    focused_onsets = {}
+    for label, pcm, r in (("v10", old_master, previous), ("v11", master, render)):
+        times = {float(n["onset"]) for n in r["all_rendered_notes"] if any(s <= n["onset"] <= e+.5 for s, e in REGIONS)}
+        focused_onsets[label] = sorted([entry(pcm, t, sr) for t in times], key=lambda x: -(x["rise_db"] or -1e9))
+    a4 = [n for n in render["all_rendered_notes"] if n["instrument"] == "guzheng" and n["pitch"] == 69]
+    checks["new_a4_uses_cleaned_g4_plus_two_semitones"] = bool(a4) and all(n["root"] == 67 and n["semitones"] == 2 for n in a4)
+    roles = sorted(set(e[4] for e in render["score"]["viola"]))
+    strings_db = stem_stats["viola"]["rms_dbfs"]-stem_stats["dizi"]["rms_dbfs"]
+    checks["strings_remain_background"] = roles == ["background"] and strings_db < -12
+    checks["strings_absent_40_to_56"] = bool(np.abs(at(stems["viola"], 40, 56, sr)).max() == 0)
+    phrases = sorted((p for p in render["phrases"] if p["instrument"] == "dizi"), key=lambda p: p["start"])
+    checks["55_wind_notes_10_phrases"] = len(phrases) == 10 and sum(len(p["pitches"]) for p in phrases) == 55
+    old_phrases = sorted((p for p in previous["phrases"] if p["instrument"] == "dizi"), key=lambda p: p["start"])
+    checks["wind_note_pitches_and_offsets_preserved"] = len(phrases) == len(old_phrases) and all(a[k] == b[k] for a, b in zip(phrases, old_phrases) for k in ("start", "end", "pitches", "offsets"))
+    gaps = []
+    for left, right in zip(phrases, phrases[1:]):
+        segment = at(stems["dizi"], left["end"], right["start"], sr)
+        gaps.append({"start": left["end"], "end": right["start"], "seconds": len(segment)/sr, "peak": float(np.abs(segment).max())})
+    checks["actual_wind_phrase_breaths_preserved"] = all(g["seconds"] >= .65-1/sr and g["peak"] == 0 for g in gaps)
+    loop = report["loop"]
+    jumps = loop["sample_jump_absolute_per_channel"]
+    nearby = loop["nearby_absolute_difference_quantiles_per_channel"]["p99"]
+    checks["loop_boundary_not_local_difference_outlier"] = all(j <= max(q, 2/32768) for j, q in zip(jumps, nearby))
+    checks["inputs_unchanged_during_audit"] = all(sha(Path(p)) == h for p, h in hashes.items())
+    result = {"status": "signal_checks_passed" if all(checks.values()) else "needs_review", "timestamp": datetime.now().astimezone().isoformat(),
+              "final_wav_sha256": expected, "audit_script_sha256": sha(Path(__file__)), "analyzer_sha256": sha(ANALYZER),
+              "analyzer_command": command, "analyzer_command_sha256": hashlib.sha256(json.dumps(command, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest(),
+              "input_hashes": hashes, "checks": checks, "failed_checks": [k for k, v in checks.items() if not v],
+              "overall": report["overall"], "stem_reconstruction": reconstruction, "stems": stem_stats,
+              "independent_periodic_room_recheck": room_recheck, "target_region_comparison": regions,
+              "fixed_entry_comparison": entrances, "all_focused_onsets_largest_rise_first": focused_onsets,
+              "a4_identity": {"events": a4, "source": next(m for m in render["guzheng_mapping"] if m["root"] == 67),
