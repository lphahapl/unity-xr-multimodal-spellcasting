+        {
+            if (EditorApplication.isPlayingOrWillChangePlaymode || SceneManager.GetActiveScene().isDirty || SceneManager.GetActiveScene().path != LinearRpgValidation.P1ScenePath)
+                throw new InvalidOperationException("需要已保存的 P1 场景");
