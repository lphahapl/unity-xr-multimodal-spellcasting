+                              "Half-second entry differences and quarter-second windows describe energy; they do not prove expressive or natural handoffs.",
+                              "Held dizi recordings are joined by programmed phrase crossfades, not recorded legato transitions.",
+                              "A small clip-boundary jump and converged room demonstrate file/state consistency, not the target player's actual scheduling."]}
+    target = LOG/"qa-summary.json"
+    with target.open("x", encoding="utf-8") as out:
+        json.dump(result, out, ensure_ascii=False, allow_nan=False, indent=2)
+    print(json.dumps({"status": result["status"], "hash": expected, "failed": result["failed_checks"],
+                      "overall": result["overall"], "reconstruction": reconstruction, "room": room_recheck,
+                      "entries": entrances, "quiet_regions": [{"start": x["start"], "end": x["end"],
+                      "v10_longest_below_minus60": x["v10"]["near_quiet_screening"]["-60"]["longest_seconds"],
+                      "v11_longest_below_minus60": x["v11"]["near_quiet_screening"]["-60"]["longest_seconds"]} for x in regions]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
