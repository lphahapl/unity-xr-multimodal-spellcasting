+using System;
+using UnityEngine;
+using UnityEngine.AI;
+using UnityEngine.Events;
+
+namespace NarutoVR.SealCombat.Enemies
+{
+    /// <summary>敌人决策与导航入口。Animator 只表现动作；位移和转向由导航/本组件负责。</summary>
+    [DisallowMultipleComponent, RequireComponent(typeof(NavMeshAgent))]
+    public sealed class EnemyController : MonoBehaviour
+    {
+        public enum Behaviour
+        {
+            [InspectorName("待机")] Idle, [InspectorName("巡逻")] Patrol,
+            [InspectorName("追击")] Chase, [InspectorName("转向")] Turn,
+            [InspectorName("攻击")] Attack, [InspectorName("暂停")] Suspended
+        }
+        [Serializable] public sealed class AttackEvent : UnityEvent<int> { }
+
+        [Header("一、引用与生成类型")]
+        [InspectorName("动画控制器")] public Animator animator;
+        [InspectorName("玩家目标（普通敌人为待发现目标）")] public Transform target;
+        [InspectorName("召唤敌人（不巡逻，直接追目标）")] public bool isSpawnedEnemy;
+        [InspectorName("自动更新（外部调度 Tick 时关闭）")] public bool tickAutomatically = true;
+        [Header("二、场景巡逻点")]
+        [InspectorName("巡逻点（按顺序循环）")] public Transform[] patrolPoints = Array.Empty<Transform>();
+        [InspectorName("巡逻速度"), Min(.01f)] public float patrolSpeed = .9f;
+        [InspectorName("抵达距离"), Min(.05f)] public float patrolArrivalDistance = .3f;
+        [InspectorName("到点停留秒数"), Min(0)] public float patrolWaitSeconds = 1.5f;
+        [Header("三、发现与追击")]
+        [InspectorName("发现距离"), Min(.1f)] public float detectionDistance = 8;
+        [InspectorName("视野角度（总角）"), Range(1, 360)] public float fieldOfView = 120;
+        [InspectorName("遮挡检测")] public bool checkLineOfSight = true;
+        [InspectorName("视线遮挡层（不含自身与玩家层）")] public LayerMask obstructionMask = Physics.DefaultRaycastLayers;
+        [InspectorName("视线起点高度"), Min(0)] public float eyeHeight = 1.4f;
+        [InspectorName("丢失目标距离"), Min(.1f)] public float loseDistance = 12;
+        [InspectorName("遮挡后保留追击秒数"), Min(0)] public float loseSightSeconds = 2;
+        [InspectorName("追击速度"), Min(.01f)] public float chaseSpeed = 2;
+        [InspectorName("转向角速度"), Min(1)] public float turnSpeed = 120;
+        [InspectorName("重算路径间隔"), Min(.05f)] public float repathSeconds = .25f;
+        [InspectorName("目标投影到导航面的最大距离"), Min(.1f)] public float navSampleRadius = 2;
+        [Header("四、独立攻击动作（0 默认，1 对应 attack1）")]
+        [InspectorName("独立攻击动作总数"), Min(1)] public int attackCount = 2;
+        [InspectorName("攻击距离"), Min(.1f)] public float attackDistance = 1.6f;
+        [InspectorName("允许攻击的朝向误差"), Range(1, 90)] public float attackFacingAngle = 15;
+        [InspectorName("攻击结束后冷却秒数"), Min(0)] public float attackCooldown = 1.5f;
+        [InspectorName("攻击接触回调时刻（动画归一化进度）"), Range(.01f, .95f)] public float contactNormalizedTime = .55f;
+        [InspectorName("进入攻击动画超时秒数"), Min(.1f)] public float animationEntryTimeout = 1;
+        [InspectorName("攻击动画最大等待秒数"), Min(1)] public float attackTimeout = 8;
+        [Header("五、事件（首次发现每轮生成只触发一次）")]
+        [InspectorName("首次发现玩家")] public UnityEvent onFirstPlayerDetected = new();
+        [InspectorName("开始攻击（动作编号）")] public AttackEvent onAttackStarted = new();
+        [InspectorName("攻击接触时刻（仅事件，不自动扣血）")] public AttackEvent onAttackContact = new();
+        [InspectorName("攻击结束（含取消，动作编号）")] public AttackEvent onAttackFinished = new();
+        [Header("六、运行状态（只读观察，请勿手改）")]
+        [SerializeField, InspectorName("曾首次发现玩家")] bool hasEverDetectedPlayer;
+        [SerializeField, InspectorName("当前已发现有效目标")] bool hasTarget;
+        [SerializeField, InspectorName("当前行为")] Behaviour currentBehaviour;
+        [SerializeField, InspectorName("水平目标夹角（左负右正）")] float angle;
+        [SerializeField, InspectorName("当前攻击编号")] int currentAttack = -1;
+        [SerializeField, InspectorName("状态说明")] string status = "等待初始化";
+
+        public bool HasEverDetectedPlayer => hasEverDetectedPlayer;
+        public bool HasTarget => hasTarget;
+        public Behaviour CurrentBehaviour => currentBehaviour;
+        public int CurrentAttack => currentAttack;
+        public float Angle => angle;
+        public string Status => status;
+        public NavMeshAgent Agent => agent;
+
+        NavMeshAgent agent;
+        float clock, nextPathAt, waitUntil, cooldownUntil, attackStartedAt, lastSeenAt;
+        int patrolIndex, generation;
+        bool initialized, suspended, waitingAtPatrol, attackEntered, contactSent, animationValid;
+        bool inTick;
+        Transform assignedTarget;
+        Vector3 navigationDestination;
+        bool hasNavigationDestination;
+        readonly RaycastHit[] sightHits = new RaycastHit[32];
+        NavMeshPath path;
+        static readonly int Found = Animator.StringToHash("isFindPlayer"), Attacking = Animator.StringToHash("isAttacking"),
+            AngleParameter = Animator.StringToHash("angle"), Motion = Animator.StringToHash("motionState");
+
+        void Awake() => EnsureInitialized();
+        void OnEnable() { EnsureInitialized(); ResetForSpawn(); }
+        void Update() { if (tickAutomatically) Tick(Time.deltaTime); }
+        void OnDisable() { StopNavigation(); CancelAttack(); }
+
+        void EnsureInitialized()
+        {
+            // NavMeshPath 创建原生对象，不能放在 MonoBehaviour 字段初始化器中。
+            path ??= new NavMeshPath();
+            if (initialized) return;
+            agent = GetComponent<NavMeshAgent>();
+            if (!animator) animator = GetComponentInChildren<Animator>();
+            agent.updateRotation = false;
+            if (animator) animator.applyRootMotion = false;
+            initialized = true;
+        }
+
+        /// <summary>生成器入口。先设置类型和目标，再重置本轮首次发现标志。</summary>
+        public void InitializeSpawn(Transform player, bool summoned)
+        { isSpawnedEnemy = summoned; target = player; ResetForSpawn(); }
+
+        /// <summary>更换目标不重置首次发现事件。传 null 后召唤敌人待机。</summary>
+        public void SetTarget(Transform player)
+        {
+            if (target == player && assignedTarget == player) return;
+            ++generation; target = assignedTarget = player;
+            hasTarget = false; nextPathAt = 0;
+            StopNavigation(); CancelAttack();
+        }
+
+        /// <summary>暂停/演出/死亡均可显式调用。恢复不会重播已触发的首次发现事件。</summary>
+        public void SetSuspended(bool value)
+        {
+            ++generation; suspended = value;
+            if (value) { StopNavigation(); CancelAttack(); if (this && suspended) SetBehaviour(Behaviour.Suspended, "外部暂停"); }
+        }
+
+        public void ResetForSpawn()
+        {
+            EnsureInitialized(); ++generation;
+            // 池化重置不发出上一轮攻击结束业务事件。
+            currentAttack = -1; hasTarget = hasEverDetectedPlayer = suspended = false;
+            clock = nextPathAt = waitUntil = cooldownUntil = lastSeenAt = 0;
+            patrolIndex = 0; waitingAtPatrol = attackEntered = contactSent = false;
+            assignedTarget = target;
+            animationValid = ValidateAnimator(out var reason);
+            StopNavigation();
+            if (animationValid)
+            {
+                ClearAttackTriggers(); animator.SetBool(Attacking, false); animator.SetBool(Found, false);
+                animator.SetInteger(Motion, 0); animator.SetFloat(AngleParameter, 0);
+                if (animator.isActiveAndEnabled) animator.Play("Base Layer.CanJiOu_Idle", 0, 0);
+            }
+            SetBehaviour(Behaviour.Idle, animationValid ? "等待目标或巡逻" : reason);
+        }
+
+        public bool ValidateAnimator(out string reason)
+        {
+            if (!animator || !animator.runtimeAnimatorController) { reason = "未绑定 Animator Controller"; return false; }
+            var parameters = animator.parameters;
+            bool Has(string n, AnimatorControllerParameterType type) => Array.Exists(parameters, p => p.name == n && p.type == type);
+            if (!Has("isFindPlayer", AnimatorControllerParameterType.Bool) || !Has("isAttacking", AnimatorControllerParameterType.Bool) ||
+                !Has("angle", AnimatorControllerParameterType.Float) || !Has("motionState", AnimatorControllerParameterType.Int))
+            { reason = "Animator 缺少基础参数或参数类型不符"; return false; }
+            if (attackCount < 1 || !animator.HasState(0, Animator.StringToHash("Base Layer.Attack.挥砍")))
+            { reason = "攻击总数或默认攻击状态无效"; return false; }
+            for (int i = 1; i < attackCount; i++)
+                if (!Has("attack" + i, AnimatorControllerParameterType.Trigger))
+                { reason = "缺少攻击 Trigger：attack" + i; return false; }
+            reason = "配置有效"; return true;
+        }
+
+        /// <summary>可供外部统一调度；使用时关闭自动更新。时间随游戏时间暂停，不用墙钟跳过攻击。</summary>
+        public void Tick(float deltaTime)
+        {
+            if (inTick) return;
+            inTick = true;
+            try { TickCore(deltaTime); }
+            finally { inTick = false; }
+        }
+
+        void TickCore(float deltaTime)
+        {
+            EnsureInitialized();
+            if (!isActiveAndEnabled || !float.IsFinite(deltaTime) || deltaTime <= 0) return;
+            clock += deltaTime;
+            lastDelta = deltaTime;
+            if (assignedTarget != target) SetTarget(target);
+            if (!this || !isActiveAndEnabled) return;
+            int tickGeneration = generation;
+            if (suspended) { StopNavigation(); SetBehaviour(Behaviour.Suspended, "外部暂停"); return; }
+            if (!animationValid || !animator || !animator.isActiveAndEnabled)
+            { StopNavigation(); status = "动画配置无效或已禁用，暂停行动"; CancelAttack(); return; }
+
+            bool validTarget = target && target.gameObject.activeInHierarchy;
+            if (!validTarget) { hasTarget = false; CancelAttack(); }
+            else
+            {
+                Vector3 delta = target.position - transform.position;
+                angle = HorizontalAngle(transform.forward, delta);
+                bool visible = delta.magnitude <= (hasTarget ? Mathf.Max(detectionDistance, loseDistance) : detectionDistance) &&
+                    (hasTarget || Mathf.Abs(angle) <= fieldOfView * .5f) && HasLineOfSight();
+                if (isSpawnedEnemy || visible)
+                {
+                    if (!hasTarget) { waitingAtPatrol = false; StopNavigation(); }
+                    hasTarget = true; lastSeenAt = clock;
+                    if (!hasEverDetectedPlayer)
+                    {
+                        hasEverDetectedPlayer = true; int token = generation; Transform seen = target;
+                        onFirstPlayerDetected.Invoke();
+                        // 回调可以开演出、换目标、销毁/禁用敌人或重新生成。
+                        if (!this || !isActiveAndEnabled || suspended || generation != token || target != seen) return;
+                        if (!target || !target.gameObject.activeInHierarchy) { hasTarget = false; StopNavigation(); return; }
+                    }
+                }
+                else if (hasTarget && (delta.magnitude > Mathf.Max(detectionDistance, loseDistance) || clock - lastSeenAt >= loseSightSeconds))
+                { hasTarget = false; StopNavigation(); CancelAttack(); }
+            }
+            if (!this || !isActiveAndEnabled || suspended || generation != tickGeneration) return;
+            animator.SetBool(Found, hasTarget);
+            animator.SetFloat(AngleParameter, angle);
+            if (currentAttack >= 0) { TickAttack(); return; }
+            if (!hasTarget) { TickPatrol(); return; }
+
+            Vector3 toTarget = target.position - transform.position;
+            var flat = Vector3.ProjectOnPlane(toTarget, Vector3.up);
+            if (flat.magnitude <= attackDistance && Mathf.Abs(toTarget.y) <= navSampleRadius)
+            {
+                StopNavigation();
+                RotateTowards(flat, deltaTime);
+                angle = HorizontalAngle(transform.forward, flat);
+                if (Mathf.Abs(angle) > attackFacingAngle)
+                    SetBehaviour(Behaviour.Turn, "近距离转向目标");
+                else if (clock >= cooldownUntil && HasLineOfSight() && !animator.IsInTransition(0) &&
+                    !animator.GetCurrentAnimatorStateInfo(0).IsTag("EnemyAttack")) BeginAttack();
+                else SetBehaviour(Behaviour.Idle, "攻击冷却或视线被遮挡");
+            }
+            else
+            {
+                if (MoveTo(target.position, chaseSpeed, attackDistance * .85f))
+                { RotateTowards(agent.desiredVelocity.sqrMagnitude > .001f ? agent.desiredVelocity : flat, deltaTime); SetBehaviour(Behaviour.Chase, "追击玩家"); }
+                else SetBehaviour(Behaviour.Idle, status);
+            }
+        }
+
+        public static float HorizontalAngle(Vector3 forward, Vector3 direction)
+        {
+            forward.y = direction.y = 0;
+            return forward.sqrMagnitude < .0001f || direction.sqrMagnitude < .0001f ? 0 : Vector3.SignedAngle(forward, direction, Vector3.up);
+        }
+
+        bool HasLineOfSight()
+        {
+            if (!target) return false;
+            if (!checkLineOfSight) return true;
+            Vector3 start = transform.position + Vector3.up * eyeHeight, delta = target.position - start;
+            int count = Physics.RaycastNonAlloc(start, delta.normalized, sightHits, delta.magnitude, obstructionMask, QueryTriggerInteraction.Ignore);
+            if (count == sightHits.Length) return false; // 缓冲已满时保守地认为遮挡。
+            for (int i = 0; i < count; i++)
+            {
+                Transform hit = sightHits[i].transform;
+                if (hit == transform || hit.IsChildOf(transform) || hit == target || hit.IsChildOf(target) || target.IsChildOf(hit)) continue;
+                return false;
+            }
+            return true;
+        }
+
+        void TickPatrol()
+        {
+            if (isSpawnedEnemy) { StopNavigation(); SetBehaviour(Behaviour.Idle, "召唤敌人无目标，待机"); return; }
+            if (patrolPoints == null || patrolPoints.Length == 0)
+            { StopNavigation(); SetBehaviour(Behaviour.Idle, "未配置巡逻点，待机"); return; }
+            patrolIndex %= patrolPoints.Length;
+            int searched = 0;
+            while (!patrolPoints[patrolIndex] && searched++ < patrolPoints.Length) patrolIndex = (patrolIndex + 1) % patrolPoints.Length;
+            if (!patrolPoints[patrolIndex]) { StopNavigation(); SetBehaviour(Behaviour.Idle, "巡逻点均为空"); return; }
+            if (waitingAtPatrol)
+            {
+                if (clock < waitUntil) { SetBehaviour(Behaviour.Idle, "巡逻到点停留"); return; }
+                waitingAtPatrol = false; patrolIndex = (patrolIndex + 1) % patrolPoints.Length; nextPathAt = 0;
+                return; // 下一次更新跳过空点后再寻路。
+            }
+            if (!MoveTo(patrolPoints[patrolIndex].position, patrolSpeed, patrolArrivalDistance))
+            { SetBehaviour(Behaviour.Idle, status); return; }
+            if (!agent.pathPending && hasNavigationDestination &&
+                (Vector3.Distance(transform.position, navigationDestination) <= patrolArrivalDistance + .05f ||
+                 (agent.hasPath && agent.remainingDistance <= patrolArrivalDistance + .05f)))
+            { StopNavigation(); waitingAtPatrol = true; waitUntil = clock + patrolWaitSeconds; SetBehaviour(Behaviour.Idle, "巡逻到点停留"); return; }
+            RotateTowards(agent.desiredVelocity, lastDelta);
+            SetBehaviour(Behaviour.Patrol, "巡逻点 " + (patrolIndex + 1));
+        }
+
+        float lastDelta;
+        void RotateTowards(Vector3 direction, float dt)
+        {
+            direction.y = 0;
+            if (direction.sqrMagnitude > .0001f)
+                transform.rotation = Quaternion.RotateTowards(transform.rotation, Quaternion.LookRotation(direction), turnSpeed * dt);
+        }
+
+        bool MoveTo(Vector3 destination, float speed, float stopping)
+        {
+            if (!agent || !agent.isActiveAndEnabled || !agent.isOnNavMesh)
+            { status = "未处于有效 NavMesh，停止移动"; return false; }
+            agent.speed = speed; agent.stoppingDistance = stopping;
+            if (clock < nextPathAt) return hasNavigationDestination &&
+                ((agent.hasPath && agent.pathStatus == NavMeshPathStatus.PathComplete) || Vector3.Distance(transform.position, navigationDestination) <= stopping + .05f);
+            nextPathAt = clock + Mathf.Max(.05f, repathSeconds);
+            if (!NavMesh.SamplePosition(destination, out var hit, navSampleRadius, agent.areaMask) ||
+                !agent.CalculatePath(hit.position, path) || path.status != NavMeshPathStatus.PathComplete)
+            { StopNavigation(false); status = "目标无完整导航路径，等待重试"; return false; }
+            agent.isStopped = false;
+            if (agent.SetPath(path)) { navigationDestination = hit.position; hasNavigationDestination = true; return true; }
+            StopNavigation(false); status = "导航路径提交失败"; return false;
+        }
+
+        void StopNavigation(bool resetRepath = true)
+        {
+            hasNavigationDestination = false;
+            if (agent && agent.isActiveAndEnabled && agent.isOnNavMesh)
+            { agent.isStopped = true; agent.ResetPath(); agent.velocity = Vector3.zero; }
+            if (resetRepath) nextPathAt = 0;
+        }
+
+        void BeginAttack()
+        {
+            // 整数上界不包含，N 个独立动作严格选择 0..N-1。
+            ClearAttackTriggers(); currentAttack = UnityEngine.Random.Range(0, Mathf.Max(1, attackCount));
+            attackStartedAt = clock; attackEntered = contactSent = false;
+            if (currentAttack > 0) animator.SetTrigger("attack" + currentAttack);
+            animator.SetBool(Attacking, true);
+            SetBehaviour(Behaviour.Attack, "攻击动作 " + currentAttack);
+            onAttackStarted.Invoke(currentAttack);
+        }
+
+        void TickAttack()
+        {
+            StopNavigation();
+            var state = animator.GetCurrentAnimatorStateInfo(0);
+            if (state.IsTag("EnemyAttack") && !animator.IsInTransition(0))
+            {
+                attackEntered = true;
+                if (!contactSent && state.normalizedTime >= contactNormalizedTime)
+                {
+                    contactSent = true; int token = generation, attack = currentAttack;
+                    if (hasTarget && target && HasLineOfSight() &&
+                        Vector3.ProjectOnPlane(target.position - transform.position, Vector3.up).magnitude <= attackDistance + .5f &&
+                        Mathf.Abs(target.position.y - transform.position.y) <= navSampleRadius)
+                        onAttackContact.Invoke(attack);
+                    if (!this || generation != token || currentAttack != attack || suspended || !isActiveAndEnabled) return;
+                }
+                if (state.normalizedTime >= .98f) { CancelAttack(); return; }
+            }
+            else if (attackEntered && !animator.IsInTransition(0)) { CancelAttack(); return; }
+            if ((!attackEntered && clock - attackStartedAt >= animationEntryTimeout) || clock - attackStartedAt >= attackTimeout)
+            { CancelAttack(); if (this && currentAttack < 0) status = "攻击动画未进入或超时，已复位"; }
+        }
+
+        public void CancelAttack()
+        {
+            if (currentAttack < 0) return;
+            int finished = currentAttack; currentAttack = -1; cooldownUntil = clock + Mathf.Max(0, attackCooldown);
+            if (animationValid && animator) { animator.SetBool(Attacking, false); ClearAttackTriggers(); }
+            SetBehaviour(Behaviour.Idle, "攻击结束或取消，等待冷却");
+            onAttackFinished.Invoke(finished);
+        }
+
+        void ClearAttackTriggers()
+        {
+            if (!animator) return;
+            foreach (var parameter in animator.parameters)
+                if (parameter.type == AnimatorControllerParameterType.Trigger && parameter.name.StartsWith("attack", StringComparison.Ordinal))
+                    animator.ResetTrigger(parameter.nameHash);
+        }
+
+        void SetBehaviour(Behaviour behaviour, string reason)
+        {
+            currentBehaviour = behaviour; status = reason;
+            if (!animationValid || !animator) return;
+            animator.SetInteger(Motion, behaviour == Behaviour.Patrol ? 1 : behaviour == Behaviour.Chase ? 2 : behaviour == Behaviour.Turn ? 3 : 0);
+            animator.SetFloat(AngleParameter, angle);
+        }
+
+        void OnValidate()
+        {
+            attackCount = Mathf.Max(1, attackCount); loseDistance = Mathf.Max(detectionDistance, loseDistance);
+            attackTimeout = Mathf.Max(animationEntryTimeout + .1f, attackTimeout);
+        }
+    }
+}
