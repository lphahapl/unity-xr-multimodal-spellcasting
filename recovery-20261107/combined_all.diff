+              "sections": report["sections"], "string_minus_dizi_rms_db": strings_db, "wind_phrase_gaps": gaps,
+              "loop": loop, "opening_rms_dbfs": {str(t): db(rms(master[:round(t*sr)])) for t in (.1, .5, 1)},
+              "mono_observation_only": {"v11": mono(master), "v10": mono(old_master)},
+              "limitations": ["No subjective listening or Unity/device playback verification in this report.",
