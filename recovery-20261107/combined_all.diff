+    alpha = np.sin(w) / (2 * fc / bandwidth)
+    c = np.cos(w)
+    b = np.array([1 + alpha * amplitude, -2 * c, 1 - alpha * amplitude])
+    a = np.array([1 + alpha / amplitude, -2 * c, 1 - alpha / amplitude])
+    return np.r_[b / a[0], 1, a[1:] / a[0]]
