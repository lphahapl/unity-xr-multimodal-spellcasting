+        (37.3, 74, .7, .034), (38.25, 72, 1.15, .036),
+        (44.25, 76, 1.35, .032), (46, 74, 1.35, .030),
+        (61.4, 74, .7, .035), (62.25, 72, 1.1, .038),
+        (76.55, 76, .9, .031), (77.6, 74, .7, .029), (78.5, 72, 1.18, .032),
