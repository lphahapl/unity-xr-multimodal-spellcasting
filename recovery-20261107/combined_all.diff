+            return true;
+        }
+        void OnApplicationPause(bool paused)
+        {
+            appPaused = paused;
+            if (!MusicReady) return;
+            if (paused)
+            {
+                VoiceDucking = false; DuckGain = 1; ApplyVolumes();
