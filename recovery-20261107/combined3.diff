@@ -0,0 +1,129 @@
+using System;
+using System.Collections.Generic;
+using UnityEngine;
+using UnityEngine.Events;
+
+namespace NarutoVR.SealCombat
+{
+    [Serializable]
+    public sealed class NarrationLine
+    {
+        [Tooltip("Resources/Narration 下的音频名或相对路径，可带音频扩展名。")]
+        public string audioFileName;
+        public string speaker;
+        [Tooltip("本句自然播完时触发，在下一句开始之前执行。")]
+        public UnityEvent onCompleted = new UnityEvent();
+
+        internal string ResourcePath
+        {
+            get
+            {
+                string name = (audioFileName ?? "").Trim().Replace('\\\\', '/');
+                switch (System.IO.Path.GetExtension(name).ToLowerInvariant())
+                {
+                    case ".wav": case ".mp3": case ".ogg": case ".aif": case ".aiff":
+                    case ".flac": case ".xm": case ".mod": case ".it": case ".s3m":
+                        name = name.Substring(0, name.LastIndexOf('.'));
+                        break;
+                }
+                return "Narration/" + name;
+            }
+        }
+    }
+
+    [DisallowMultipleComponent, RequireComponent(typeof(AudioSource))]
+    public sealed class NarrationController : MonoBehaviour
+    {
+        public List<NarrationLine> lines = new List<NarrationLine>();
+        [Tooltip("最后一句的单句事件执行完毕后触发。")]
+        public UnityEvent onDialogueCompleted = new UnityEvent();
+        public NarrationLine CurrentLine { get; private set; }
+
+        AudioSource voice;
+        int index;
+        int playbackVersion;
+        bool waitingForAudio;
+
+        void Reset() => GetComponent<AudioSource>().playOnAwake = false;
+        void OnDisable() => StopDialogue();
+
+        public void StartDialogue()
+        {
+            if (CurrentLine != null || !isActiveAndEnabled || lines == null || lines.Count == 0) return;
+            voice = GetComponent<AudioSource>();
+            voice.loop = false;
+            index = 0;
+            StartLine();
+        }
+
+        public void RestartDialogue()
+        {
+            StopDialogue();
+            StartDialogue();
+        }
+
+        public void StopDialogue()
+        {
+            ++playbackVersion;
+            if (voice && CurrentLine != null)
+            {
+                voice.Stop();
+                voice.clip = null;
+            }
+            CurrentLine = null;
+        }
+
+        void StartLine()
+        {
+            CurrentLine = lines[index];
+            AudioClip clip = CurrentLine == null || string.IsNullOrWhiteSpace(CurrentLine.audioFileName)
+                ? null : Resources.Load<AudioClip>(CurrentLine.ResourcePath);
+            if (!clip || !voice.enabled || clip.loadState == AudioDataLoadState.Failed ||
+                (clip.loadState == AudioDataLoadState.Unloaded && !clip.LoadAudioData()))
+            {
+                Debug.LogError($"旁白第 {index + 1} 句无法播放：{CurrentLine?.ResourcePath}。请检查音频与 AudioSource。", this);
+                StopDialogue();
+                return;
+            }
+            voice.clip = clip;
+            waitingForAudio = clip.loadState == AudioDataLoadState.Loading;
+            if (!waitingForAudio) voice.Play();
+        }
+
+        void Update()
+        {
+            if (CurrentLine == null) return;
+            if (!voice || !voice.enabled || !voice.clip || voice.clip.loadState == AudioDataLoadState.Failed)
+            {
+                Debug.LogError($"旁白第 {index + 1} 句音频中断。", this);
+                StopDialogue();
+                return;
+            }
+            if (AudioListener.pause && !voice.ignoreListenerPause) return;
+            if (waitingForAudio)
+            {
+                if (voice.clip.loadState == AudioDataLoadState.Loading) return;
+                waitingForAudio = false;
+                voice.Play();
+                return;
+            }
+            if (voice.isPlaying) return;
+
+            int version = playbackVersion;
+            try { CurrentLine.onCompleted?.Invoke(); }
+            catch
+            {
+                if (version == playbackVersion) StopDialogue();
+                throw;
+            }
+            // A listener may stop, restart, or disable this controller.
+            if (version != playbackVersion) return;
+            if (++index < lines.Count) StartLine();
+            else
+            {
+                StopDialogue();
+                onDialogueCompleted?.Invoke();
+            }
+        }
+    }
+}
