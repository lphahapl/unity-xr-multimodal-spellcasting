+    window = np.hanning(len(x))[:, None]
+    nfft = max(65536, 2 ** int(np.ceil(np.log2(len(x) * 4))))
+    power = np.mean(abs(np.fft.rfft(x * window, nfft, axis=0)) ** 2, axis=1)
+    return np.fft.rfftfreq(nfft, 1 / SR), power
+
