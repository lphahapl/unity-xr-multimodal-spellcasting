+"""Read-only independent v8 score audit; writes only the authorized score-review.json."""
+import hashlib
+import json
+import math
+from collections import defaultdict
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import numpy as np
+import soundfile as sf
+
+from audit_yicun_arrangement_v7 import audit, note_name
+
+ROOT = Path(__file__).resolve().parents[1]
+FOLDER = ROOT / "Logs/yicun-shanhe-shape-v8"
+
+
+def rms_db(signal):
+    return float(20*np.log10(max(float(np.sqrt(np.mean(signal*signal))), 1e-15)))
+
+
+def main():
+    report_path = FOLDER / "render.json"
+    raw = report_path.read_bytes()
+    report = json.loads(raw)
+    score = report["score"]
+    counts, events = defaultdict(int), []
+    for note in report["all_rendered_notes"]:
+        inst = note["instrument"]
+        index = counts[inst]
+        counts[inst] += 1
+        nominal = score[inst][index]
+        assert abs(nominal[0]-note["onset"]) < 1e-9 and nominal[1] == note["pitch"]
+        events.append({"id": f"{inst}:{index}", "instrument": inst,
+                       "onset": note["onset"], "midi": note["pitch"],
+                       "note": note_name(note["pitch"]), "nominal_duration": nominal[2],
+                       "dry_duration": note["duration_seconds"],
+                       "dry_end": note["onset"]+note["duration_seconds"],
+                       "velocity": note["velocity"], "technique": note["role"]})
+    observed = audit(events, period=104)
+    main_close_pairs = [p for p in observed["literal_adjacent_intervals"]
+                        if not (p["first"].startswith("bell:") or p["second"].startswith("bell:"))]
+    assert not main_close_pairs
+    assert not observed["semitone_or_tritone_overlaps"]
+    assert not observed["loop_boundary_adjacent_intervals"]
+    assert observed["dizi_overlap_count"] == 0
+    assert observed["pitch_classes"] == [0, 2, 4, 7, 9]
+    string_breath_overlap = [e for e in events if e["instrument"] == "viola" and min(e["dry_end"],52)>max(e["onset"],40)]
+    assert not string_breath_overlap
+    first_entrances = {i: min(e["onset"] for e in events if e["instrument"] == i) for i in counts}
+    introductory_events = [e for e in events if e["onset"] < 8]
+    assert sum(e["instrument"] == "guzheng" for e in introductory_events) == 4
+    assert not any(e["instrument"] == "dizi" for e in introductory_events)
+
+    # Read actual dry PCM gaps rather than relying only on the metadata.
+    rate = report["sample_rate"]
+    flute, stem_rate = sf.read(FOLDER / "dry_dizi.wav", always_2d=True)
+    assert stem_rate == rate and len(flute) == 104*rate
+    wind = sorted((e for e in events if e["instrument"] == "dizi"), key=lambda e:e["onset"])
+    flute_gaps = []
+    for first, second in zip(wind, wind[1:]):
+        begin = round(first["onset"]*rate)+round(first["dry_duration"]*rate)
+        end = round(second["onset"]*rate)
+        peak = float(np.max(np.abs(flute[begin:end])))
+        assert end-begin >= round(.04*rate)-1 and peak == 0
+        flute_gaps.append({"after": first["id"], "before": second["id"],
+                           "frames": end-begin, "seconds": (end-begin)/rate, "pcm_peak": peak})
+    del flute
+
+    bell_windows = []
