+"""Continuity edits over v10's recorded, phrase-connected performance.
+
+The caller supplies both score and phrases to rendering. No hidden score rebuild
+may silently discard the revised return envelope or accompaniment transitions.
+"""
+import copy
+
+import numpy as np
+
+import yicun_dizi_phrases_v10 as previous
+from render_yicun_shanhe_shape_v8 import render_raw as render_other_instruments
+
+SR = previous.SR
+CHANGES = [
+    "39.80 E4 guzheng bridges the descent into the string-free section.",
+    "42.35 E4, 44.00 E4 and 46.65 D4 add quiet connections inside the open-space phrase.",
+    "47.102 E4 guzheng is damped at 1.65s inside its existing clean source window.",
+    "Replace isolated 55.0 G4 with 53.35 E4, 54.25 G4, 55.15 A4 pickup into C5.",
+    "56.25 dizi recap uses gentler opening levels and a 180ms phrase attack.",
+    "Replace 77.98 G4 doubling with 78.15 E4 and 79.20 D4 into the guzheng C4 recap.",
+    "86.989 guzheng cadence becomes short G4, followed by 87.65 A4 into dizi C5.",
+]
+
+
+def build_score():
+    score, phrases = copy.deepcopy(previous.build_score())
+    changed = {"extended_e4": 0, "removed_g4_55": 0,
+               "removed_g4_77": 0, "changed_cadence": 0}
+    guzheng = []
+    for onset, pitch, duration, level, role in score["guzheng"]:
+        if abs(onset - 55.0) < .001 and pitch == 67:
+            changed["removed_g4_55"] += 1
+            continue
+        if abs(onset - 77.98) < .001 and pitch == 67:
+            changed["removed_g4_77"] += 1
+            continue
+        if 47.0 < onset < 47.2 and pitch == 64:
+            duration = 1.65
+            changed["extended_e4"] += 1
+        if 86.9 < onset < 87.1 and pitch == 60:
+            pitch, duration = 67, .52
+            changed["changed_cadence"] += 1
+        guzheng.append((onset, pitch, duration, level, role))
+    assert all(count == 1 for count in changed.values()), changed
+    guzheng += [
+        (39.80, 64, 1.35, .22, "transition"),
+        (42.35, 64, .60, .20, "transition"),
+        (44.00, 64, .85, .23, "transition"),
+        (46.65, 62, .35, .21, "transition"),
+        (53.35, 64, .80, .26, "transition"),
+        (54.25, 67, .75, .29, "transition"),
+        (55.15, 69, .75, .33, "transition"),
+        (78.15, 64, .85, .21, "transition"),
+        (79.20, 62, .65, .20, "transition"),
+        (87.65, 69, .36, .29, "transition"),
+    ]
+    score["guzheng"] = sorted(guzheng)
+
+    returning = next(p for p in phrases if p.get("label") == "theme_returns")
+    returning["levels"] = [.48, .56, .70, .62, .54, .47]
+    returning["attack_seconds"] = .18
+    for phrase in phrases:
+        if phrase["instrument"] == "guzheng" and phrase["start"] == 80:
+            phrase["pitches"][-1] = 67
+            phrase["pitches"].append(69)
+            phrase["offsets"].append(7.65)
+            phrase["label"] = "guzheng recap with 5-6 pickup into dizi 1"
+            phrase["development"] = "recap/vary"
+    for start, pitches, offsets, durations, levels, label in [
+        (39.8, [64], [0], [1.35], [.22], "connection into open space"),
+        (42.35, [64, 64, 62], [0, 1.65, 4.3], [.6, .85, .35],
+         [.20, .23, .21], "subdued connections inside the open-space phrase"),
+        (53.35, [64, 67, 69], [0, .9, 1.8], [.8, .75, .75],
+         [.26, .29, .33], "3-5-6 pickup into returning dizi 1"),
+        (78.15, [64, 62], [0, 1.05], [.85, .65], [.21, .20],
+         "3-2 connection into guzheng 1"),
+    ]:
+        phrases.append(dict(instrument="guzheng", start=start, pitches=pitches,
+                            offsets=offsets, durations=durations, levels=levels,
+                            label=label, development="fragment/extend"))
+
+    # The score and phrase control points share one source of truth.
+    score["dizi"] = sorted(
+        (p["start"] + offset, pitch, duration, level, p["label"])
+        for p in phrases if p["instrument"] == "dizi"
+        for pitch, offset, duration, level in zip(
+            p["pitches"], p["offsets"], p["durations"], p["levels"])
+    )
+    return score, sorted(phrases, key=lambda p: p["start"])
+
+
+def render_raw(score, duration, banks, seed, damp_all=True, *, phrases):
+    """Render exactly the supplied score and phrase envelopes, without rebuilding."""
+    expected_wind = sorted(
+        (p["start"] + offset, pitch, value, level, p["label"])
+        for p in phrases if p["instrument"] == "dizi"
+        for pitch, offset, value, level in zip(
+            p["pitches"], p["offsets"], p["durations"], p["levels"])
+    )
+    assert list(score["dizi"]) == expected_wind, "Score/phrase control mismatch"
+    other = {k: v for k, v in score.items() if k != "dizi"}
+    stems, details, _ = render_other_instruments(other, duration, banks, seed, damp_all)
+    rng = np.random.default_rng(seed)
+    wind = np.zeros((duration * SR, 2))
+    for phrase in phrases:
+        if phrase["instrument"] != "dizi":
+            continue
+        mono, notes = previous.render_phrase(banks[2], phrase, rng)
+        start = round(phrase["start"] * SR)
+        assert start >= 0 and start + len(mono) <= len(wind)
+        wind[start:start + len(mono)] += mono[:, None] * np.array([.66, .75])
+        details += notes
+    stems["dizi"] = wind
+    return stems, details, rng
