+
+
+def render():
+    LOG.mkdir(parents=True, exist_ok=True)
+    guzheng, mapping = v7.load_guzheng()
+    banks = (guzheng, v7.load_stereo_bank("viola"), v7.load_dizi())
+    # Stable historical reference, reconstructed without depending on a Logs WAV.
+    reference, _, _ = render_raw(v7.build_guzheng_score(), 96, banks, v7.SEED, damp_all=False)
+    calibration = {name: float(np.sqrt(v7.SHARES[name]/np.mean(stem**2)))
+                   for name, stem in reference.items()}
+    del reference
+    score, phrases = build_score()
+    stems, details, rng = render_raw(score, DURATION, banks, SEED)
+    time = np.arange(DURATION*SR)/SR
+    envelope_db = CubicSpline(GAIN_TIMES, GAIN_DB, bc_type="periodic")(time)
+    automation = 10**(envelope_db/20)
+    for name, stem in stems.items():
+        stem *= calibration[name]*10**(BALANCE_DB[name]/20)*automation[:, None]
+    mix = v7.circular_room(sum(stems.values()), rng)
+    freqs = np.fft.rfftfreq(len(mix), 1/SR)
+    highpass = freqs**2/(freqs**2+70**2)
+    for channel in range(2):
+        mix[:, channel] = np.fft.irfft(np.fft.rfft(mix[:, channel])*highpass, n=len(mix))
+    meter = pyln.Meter(SR)
+    # A single final gain preserves every section and phrase dynamic relationship.
+    gain = 10**((-29-meter.integrated_loudness(mix))/20)
+    mix *= gain
+    assert np.isfinite(mix).all() and np.max(np.abs(mix)) < .5
+    output = LOG / "yicun_shanhe_shape_v8.wav"
+    sf.write(output, mix, SR, subtype="PCM_16")
+    for name, stem in stems.items():
+        sf.write(LOG/f"dry_{name}.wav", stem*gain, SR, subtype="PCM_24")
+    pcm, _ = sf.read(output)
+    sections = []
+    for start, end, name, development, lead, harmony in SECTIONS:
+        segment = pcm[start*SR:end*SR]
+        sections.append({"start": start, "end": end, "name": name,
+                         "development": development, "lead": lead, "harmony": harmony,
+                         "rms_dbfs": float(20*np.log10(np.sqrt(np.mean(segment**2)))),
+                         "lufs": float(meter.integrated_loudness(segment)),
+                         "events": {inst: int(sum(start <= e[0] < end for e in events))
+                                    for inst, events in score.items()}})
+    report = {"version": 8, "seed": SEED, "duration_seconds": DURATION, "sample_rate": SR,
+              "meter": "4/4", "bpm": 60, "bars": 26, "intro_seconds": 8,
+              "intro_repeats_with_whole_clip": True,
+              "lufs": float(meter.integrated_loudness(pcm)),
+              "sample_peak_dbfs": float(20*np.log10(np.max(np.abs(pcm)))),
+              "rms_dbfs": float(20*np.log10(np.sqrt(np.mean(pcm**2)))),
+              "boundary_jump": np.abs(pcm[0]-pcm[-1]).tolist(),
+              "events": {name: len(events) for name, events in score.items()},
+              "score": score, "phrases": phrases, "sections": sections,
+              "all_rendered_notes": details, "guzheng_mapping": mapping,
+              "reference_instrument_gains": calibration,
+              "instrument_balance_db": BALANCE_DB,
+              "gain_contour": {"seconds": GAIN_TIMES, "db": GAIN_DB, "interpolation": "periodic cubic spline"},
+              "post_automation_dry_rms_dbfs": {name: float(20*np.log10(np.sqrt(np.mean((stem*gain)**2))))
+                                                 for name, stem in stems.items()},
+              "wav_sha256": hashlib.sha256(output.read_bytes()).hexdigest(),
+              "limitations": "Score, spectra and waveform validation; no subjective listening performed."}
+    (LOG/"render.json").write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(json.dumps({key: report[key] for key in ["duration_seconds", "lufs", "sample_peak_dbfs", "events", "sections", "post_automation_dry_rms_dbfs"]}, indent=2))
+
+
+if __name__ == "__main__":
+    render()
--- a/scratch/run_bgm_unity_probe.py
+++ b/scratch/run_bgm_unity_probe.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Submit bounded Unity BGM requests. A polling timeout never stops Unity."""
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import sys
+import time
+import uuid
+
+ROOT = Path(__file__).resolve().parents[1]
+OUTPUT = ROOT / "Logs/yicun-shanhe-continuity-v11"
+REQUEST = OUTPUT / "runtime-request.json"
+
+
+def read_json(path):
+    try:
+        return json.loads(path.read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return None
+
+
+def summary(request_id):
+    result_path = OUTPUT / "runtime-runs" / request_id / "result.json"
+    response_path = OUTPUT / "runtime-responses" / (request_id + ".json")
+    value = read_json(result_path) or read_json(response_path)
+    if not value:
+        return {"requestId": request_id, "status": "pending", "complete": False,
+                "resultPath": str(result_path), "responsePath": str(response_path)}
+    keys = ("requestId", "status", "complete", "passed", "diagnosticPassed", "fullLoopCompleted",
+            "reason", "detail", "sceneRestored", "wraps", "capturedFrames", "captureWav", "utc")
+    answer = {key: value[key] for key in keys if key in value}
+    answer.update(resultPath=str(result_path), responsePath=str(response_path))
+    return answer
+
+
+def submit(payload):
+    OUTPUT.mkdir(parents=True, exist_ok=True)
+    lock = OUTPUT / "runtime-submit.lock"
+    temp = OUTPUT / ("runtime-submit-" + uuid.uuid4().hex + ".tmp")
+    with lock.open("x", encoding="utf-8") as stream:
+        stream.write(str(os.getpid()))
+    try:
+        if REQUEST.exists():
+            raise RuntimeError("Another Unity request is pending; it was not overwritten.")
+        with temp.open("x", encoding="utf-8", newline="\n") as stream:
+            json.dump(payload, stream, ensure_ascii=False, allow_nan=False)
+            stream.flush()
+            os.fsync(stream.fileno())
+        # A hard link publishes the complete file atomically and refuses overwrite.
+        os.link(temp, REQUEST)
+    finally:
+        if temp.exists():
+            temp.unlink()
+        lock.unlink()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=("status", "import", "run", "poll"))
+    parser.add_argument("--id", dest="request_id")
+    parser.add_argument("--sha256")
+    parser.add_argument("--asset", default="Assets/SealCombat/Audio/kaogong_yicun_shanhe_ambient_loop.wav")
+    parser.add_argument("--guid", default="ad629548de0b8db45a1a011d0f5dcd53")
+    parser.add_argument("--duration", type=float, default=0)
+    parser.add_argument("--volume", type=float, default=.28)
+    parser.add_argument("--full-loops", type=int, default=2)
+    parser.add_argument("--diagnostic-seconds", type=float, default=0)
+    parser.add_argument("--lock-reload", action=argparse.BooleanOptionalAction, default=True)
+    parser.add_argument("--capture", action=argparse.BooleanOptionalAction, default=True)
+    parser.add_argument("--inject-reload-at-seconds", type=float, default=-1)
+    parser.add_argument("--wait-seconds", type=float, default=10)
+    args = parser.parse_args()
+    if not 0 <= args.wait_seconds <= 55:
+        parser.error("--wait-seconds must be between 0 and 55; poll again for unfinished work")
+    request_id = args.request_id or (time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:8])
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,95}", request_id):
+        parser.error("invalid request ID")
+    if args.action == "poll" and not args.request_id:
+        parser.error("poll requires --id")
+    if args.action in ("import", "run") and not re.fullmatch(r"[0-9A-Fa-f]{64}", args.sha256 or ""):
+        parser.error("import/run requires the expected --sha256")
+    if args.action != "poll":
+        existing = summary(request_id)
+        if existing["status"] != "pending":
+            print(json.dumps(existing, ensure_ascii=False))
+            return 2 if existing.get("complete") and not (existing.get("passed") or existing.get("diagnosticPassed")) else 0
+        submit(dict(action=args.action, requestId=request_id, expectedSha256=args.sha256 or "",
+                    assetPath=args.asset, expectedGuid=args.guid, expectedDurationSeconds=args.duration,
+                    volume=args.volume, fullLoops=args.full_loops, diagnosticSeconds=args.diagnostic_seconds,
+                    lockReload=args.lock_reload, capture=args.capture, injectReloadAtSeconds=args.inject_reload_at_seconds,
+                    submittedUtc=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), submittedBy="run_bgm_unity_probe.py", submitterPid=os.getpid()))
+    until = time.monotonic() + args.wait_seconds
+    while True:
+        value = summary(request_id)
+        if value.get("complete") or time.monotonic() >= until:
+            break
+        time.sleep(min(.25, max(0, until - time.monotonic())))
+    if not value.get("complete"):
+        value["nextCommand"] = f'python -X utf8 scratch/run_bgm_unity_probe.py poll --id {request_id} --wait-seconds 30'
+        value["unityStopped"] = False
+    print(json.dumps(value, ensure_ascii=False, allow_nan=False))
+    return 2 if value.get("complete") and not (value.get("passed") or value.get("diagnosticPassed")) else 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, RuntimeError) as error:
+        print(json.dumps({"status": "request_error", "error": str(error)}, ensure_ascii=False))
+        sys.exit(2)
--- a/scratch/test_yicun_pedalboard.py
+++ b/scratch/test_yicun_pedalboard.py
@@ -0,0 +1,156 @@
+"""Exercise the installed Pedalboard on actual v8 stems; no subjective verdict."""
+import hashlib
+import importlib.metadata
+import json
+import sys
+import time
+from datetime import datetime
+from pathlib import Path
+
+import numpy as np
+import soundfile as sf
+from pedalboard import Pedalboard, Reverb
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "Logs/yicun-shanhe-shape-v8"
+OUT = ROOT / "Logs/yicun-shanhe-pedalboard-v9/tool-setup"
+START, END, TAIL = 16, 24, 6
+SEND = {"guzheng": .18, "dizi": .12, "viola": .10}
+PARAMETERS = {"room_size": .52, "damping": .65, "wet_level": 1.,
+              "dry_level": 0., "width": .85, "freeze_mode": 0.}
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def rms(x):
+    return float(np.sqrt(np.mean(np.asarray(x, dtype=np.float64)**2)))
+
+
+def db(x):
+    return float(20*np.log10(x)) if x > 0 else None
+
+
+def stats(x):
+    return {"shape_channels_frames": list(x.shape), "rms_dbfs": db(rms(x)),
+            "sample_peak_dbfs": db(float(np.max(np.abs(x)))),
+            "finite": bool(np.isfinite(x).all())}
+
+
+def board(parameters=None):
+    return Pedalboard([Reverb(**(parameters or PARAMETERS))])
+
+
+def chunks(processor, samples, rate, preserve_state):
+    position, pieces = 0, []
+    sizes = [4096, 3000, 7777, 5120]
+    while position < samples.shape[1]:
+        size = sizes[len(pieces) % len(sizes)]
+        end = min(samples.shape[1], position+size)
+        if samples.shape[1]-end < 8:
+            end = samples.shape[1]
+        pieces.append(processor.process(samples[:, position:end], rate, buffer_size=512,
+                                        reset=position == 0 or not preserve_state))
+        position = end
+    return np.concatenate(pieces, axis=1), len(pieces)
+
+
+def main():
+    OUT.mkdir(parents=True, exist_ok=True)
+    rate, inputs, sources = None, {}, {}
+    for name in SEND:
+        path = SOURCE/f"dry_{name}.wav"
+        info = sf.info(path)
+        if rate is None:
+            rate = info.samplerate
+        assert info.samplerate == rate and info.channels == 2
+        clip, _ = sf.read(path, start=START*rate, stop=END*rate, dtype="float32", always_2d=True)
+        assert len(clip) == (END-START)*rate and np.isfinite(clip).all()
+        # Bench-only fade avoids truncating the final excerpt note. Source files stay untouched.
+        fade_frames = round(.05*rate)
+        clip[-fade_frames:] *= (.5+.5*np.cos(np.linspace(0, np.pi, fade_frames)))[:, None]
+        cf = np.ascontiguousarray(clip.T)
+        inputs[name] = np.pad(cf, ((0, 0), (0, TAIL*rate)))
+        sources[name] = {"path": str(path), "sha256_before": sha(path),
+                         "range_seconds": [START, END], "bench_end_fade_seconds": .05,
+                         "audio": stats(cf)}
+    dry = sum(inputs.values())
+    shared_send = np.ascontiguousarray(sum(SEND[name]*x for name, x in inputs.items()), dtype=np.float32)
+    processor = board()
+    begin = time.perf_counter()
+    wet = processor.process(shared_send, rate, buffer_size=512, reset=True)
+    elapsed = time.perf_counter()-begin
+    repeated = processor.process(shared_send, rate, buffer_size=512, reset=True)
+    fresh = board().process(shared_send, rate, buffer_size=512, reset=True)
+    changed = board({**PARAMETERS, "room_size": .28, "damping": .25}).process(
+        shared_send, rate, buffer_size=512, reset=True)
+    chunked, count = chunks(board(), shared_send, rate, preserve_state=True)
+    wrong_reset, _ = chunks(board(), shared_send, rate, preserve_state=False)
+    mixed = dry+wet
+    tail = wet[:, (END-START)*rate:]
+    first_tail, last_tail = rms(tail[:, :rate//2]), rms(tail[:, -rate//2:])
+    tail_maximum = np.max(np.abs(tail), axis=0)
+    audible_proxy = np.flatnonzero(tail_maximum > float(np.max(np.abs(wet)))*1e-4)
+    metrics = {
+        "render_wall_seconds": elapsed,
+        "repeat_same_instance_max_abs_difference": float(np.max(np.abs(wet-repeated))),
+        "repeat_fresh_instance_max_abs_difference": float(np.max(np.abs(wet-fresh))),
+        "chunk_preserved_state_max_abs_difference": float(np.max(np.abs(wet-chunked))),
+        "chunk_count": count,
+        "wrong_reset_control_difference_rms": rms(wet-wrong_reset),
+        "parameter_change_relative_rms": rms(wet-changed)/max(rms(wet), 1e-30),
+        "tail_first_half_second_rms_dbfs": db(first_tail),
+        "tail_last_half_second_rms_dbfs": db(last_tail),
+        "tail_decay_first_to_last_half_second_db": db(last_tail/first_tail) if first_tail else None,
+        "tail_last_time_above_minus80db_relative_to_wet_peak": (int(audible_proxy[-1])+1)/rate if len(audible_proxy) else None,
+        "wet_minus_dry_rms_db": db(rms(wet)/rms(dry)),
+    }
+    checks = {
+        "specified_pedalboard_version_loaded": importlib.metadata.version("pedalboard") == "0.9.26",
+        "all_source_clips_non_silent": all(s["audio"]["rms_dbfs"] is not None for s in sources.values()),
+        "finite_non_silent_wet": bool(np.isfinite(wet).all() and rms(wet) > 1e-10),
+        "length_and_channel_count_preserved": wet.shape == (2, (END-START+TAIL)*rate),
+        "parameters_change_output": metrics["parameter_change_relative_rms"] > .01,
+        "tail_present_after_input_stops": first_tail > 1e-10,
+        "six_second_padding_captures_decay": last_tail < first_tail*.001,
+        "same_instance_reset_repeats": metrics["repeat_same_instance_max_abs_difference"] < 1e-7,
+        "fresh_instance_repeats": metrics["repeat_fresh_instance_max_abs_difference"] < 1e-7,
+        "reset_false_chunks_continuous": metrics["chunk_preserved_state_max_abs_difference"] < 1e-7,
+        "reset_each_chunk_control_changes_output": metrics["wrong_reset_control_difference_rms"] > 1e-7,
+        "preview_finite_no_clipping": bool(np.isfinite(mixed).all() and np.max(np.abs(mixed)) < 1),
+        "source_files_unchanged": all(sha(Path(s["path"])) == s["sha256_before"] for s in sources.values()),
+    }
+    outputs = {}
+    for name, data in [("preview_dry_16-24_plus6", dry),
+                       ("preview_shared_return_16-24_plus6", wet),
+                       ("preview_mix_16-24_plus6", mixed)]:
+        path = OUT/f"{name}.wav"
+        sf.write(path, data.T, rate, subtype="PCM_24")
+        outputs[name] = {"path": str(path), "sha256": sha(path), **stats(data)}
+    result = {
