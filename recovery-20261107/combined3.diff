+        ir = signal.sosfilt(sos, rng.normal(size=ir_length))*decay
+        ir *= .14/np.linalg.norm(ir)
+        for seconds, level in [(.027+.008*ch, .10), (.067+.011*ch, .055)]:
+            ir[round(seconds*SR)] += level
