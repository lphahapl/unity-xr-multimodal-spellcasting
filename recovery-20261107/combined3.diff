+        public override void OnInspectorGUI()
+        {
+            DrawDefaultInspector();
+            EditorGUILayout.HelpBox("音频放在 Resources/Narration。表头为 audioFileName 和 speaker，按行播放。导入会替换列表；同名音频和说话者的事件按出现顺序保留。", MessageType.Info);
