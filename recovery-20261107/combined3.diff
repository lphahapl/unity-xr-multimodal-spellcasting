+
+
+def render_raw(score, duration, banks, seed, damp_all=True):
+    guzheng, viola, flute = banks
+    rng = np.random.default_rng(seed)
+    counters = defaultdict(int)
+    stems, details = {}, []
+    length = duration*SR
