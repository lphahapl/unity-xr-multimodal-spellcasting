+    length = len(dry)
+    ir_length = round(1.4*SR)
+    t = np.arange(ir_length)/SR
+    decay = np.exp(-6.908*t/1.4)
+    decay[:round(.033*SR)] = 0
+    sos = signal.butter(2, 4200, fs=SR, output="sos")
+    result = dry.copy()
+    folded = np.zeros((ir_length-1, 2))
