--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9a715ad30f6c44e89d5d84da34a47f0a, type: 3}
  m_Name: 首章术式教学
  m_EditorClassIdentifier: NarutoVR.Game.Runtime::NarutoVR.SealCombat.Rpg.TeachingCatalog
  entries:
  - entryId: fireball
    displayName: 火球术
    skillIds:
    - fireball
    actionHint: 成形后握住火球，向前甩手并松开
  - entryId: shield
    displayName: 衡印
    skillIds:
    - shield.left
    - buff.voice
    actionHint: 用左手结衡印，或直接念「衡印」，任选其一
  - entryId: breath.burst
    displayName: 飞炎术
    skillIds:
    - breath.burst
    actionHint: 念「飞炎术」，结律印在掌上蓄起火苗。看向目标，用准心瞄准，再结规印发射火球。
  - entryId: breath.stream
    displayName: 龙火之术
    skillIds:
    - breath.stream
    actionHint: 念「龙火之术」，结律印后印上显出火苗。举到嘴前持续喷火，移动印顶引导火流。
