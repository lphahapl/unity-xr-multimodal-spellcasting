MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9a715ad30f6c44e89d5d84da34a47f0a, type: 3}
  m_Name: 首章术式教学
  m_EditorClassIdentifier: NarutoVR.Game.Runtime::NarutoVR.SealCombat.Rpg.TeachingCatalog
  entries:
  - entryId: fireball
    displayName: 火球术
    skillIds:
    - fireball
    actionHint: 成形后握住火球，向前甩手并松开
  - entryId: shield
    displayName: 护盾
    skillIds:
    - buff.zi
    - buff.voice
    actionHint: 两种方式任选其一
  - entryId: breath.burst
    displayName: 飞炎术
    skillIds:
    - breath.burst
    actionHint: 把律印举到嘴前，让印顶对准目标，念「飞炎术」。火弹从嘴边穿过印顶直线飞出。
  - entryId: breath.stream
    displayName: 龙火之术
    skillIds:
    - breath.stream
    actionHint: 在嘴前保持律印，念「龙火之术」。移动印顶引导火流，松印或把手移远即可停火。
