  m_Script: {fileID: 11500000, guid: 8e9644fb855d45dbb5c7db993ced5c75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: NarutoVR.Game.Runtime::NarutoVR.SealCombat.VFXShowcasePreviewer
  categories:
  - categoryName: "[1] 风遁"
    themeColor: {r: 0.35, g: 1, b: 0.85, a: 1}
    entries:
    - title: "风遁·龙卷飓风 (持续风暴)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer3/Winds/LargeTornado/Prefabs/WindContinous.prefab"
      description: "持续性多层旋转飓风，气流升腾与外围旋转风环，极度震撼 (风遁·龙卷飓风)"
      spawnOffset: {x: 0, y: 0, z: 0}
      spawnScale: 1
      prefab: {fileID: 3779071182227284033, guid: 0b64d0c860bc7e54c91f3020d4edfbcf, type: 3}
      motion: 0
    - title: "风遁·大龙卷 (瞬间爆发)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer3/Winds/TornadoOneShotLarge/Prefabs/Par_TornadoOneShotLarge.prefab"
      description: "单发瞬发巨型风暴爆发，地面气浪狂暴外扩冲击"
      spawnOffset: {x: 0, y: 0, z: 0}
      spawnScale: 1
      prefab: {fileID: 8136324697203328686, guid: 79acaf27f30988f4097eff2efdb8fe3c, type: 3}
      motion: 0
    - title: "风遁·大突破 (横向推进风压)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer3/Winds/HorizontalWind/Prefabs/Par_HorizontalWind.prefab"
      description: "强力横向气浪喷涌，经典风遁大突破推进"
      spawnOffset: {x: 0, y: 0.8, z: 0}
      spawnScale: 1
      prefab: {fileID: 1994029076158903789, guid: d0e85749e7513e2409f42bc85a17ca5b, type: 3}
      motion: 0
    - title: "风遁·螺旋聚气 (气旋蓄力)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer3/Winds/WindCharge/Prefabs/WindCharge.prefab"
      description: "中心高速内吸汇聚气流，极度贴合螺旋丸/风遁聚气蓄力"
      spawnOffset: {x: 0, y: 1.2, z: 0}
      spawnScale: 1
      prefab: {fileID: 7007953901473171864, guid: 0a2e23f9108d5c145b5c6736fcee97e9, type: 3}
      motion: 0
    - title: "风遁·真空连波 (疾风剑气飞刃)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer3/Slashes/WindSlashes/Prefabs/Par_WindSwordBeam.prefab"
      description: "凌厉青风刀光呼啸前斩，镰鼬之术/真空风刃"
      spawnOffset: {x: 0, y: 1.0, z: 0}
      spawnScale: 1
      prefab: {fileID: 1858485398176448756, guid: e0a9c77793f214c4ca83c30c371d9e40, type: 3}
      motion: 0
    - title: "风遁·压害 (压缩空气风弹)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer3/Shoots/WindShoots/Prefabs/Par_WindBullet.prefab"
      description: "高速压缩空气炮/风遁查克拉风弹"
      spawnOffset: {x: 0, y: 1.0, z: 0}
      spawnScale: 1
      prefab: {fileID: 9103632281160831739, guid: c9ea76b8c484ef747976084556ecc86b, type: 3}
      motion: 0
    - title: "风遁·瞬身气浪 (气旋瞬爆)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer3/Winds/WindFlash/Prefabs/Par_WindFlash.prefab"
      description: "瞬身移动或短距冲刺时的环形气流爆散"
      spawnOffset: {x: 0, y: 0.5, z: 0}
      spawnScale: 1
      prefab: {fileID: 7912708666193520125, guid: e49b028ed03ee374f8cd90ca7092b9e3, type: 3}
      motion: 0
    - title: "风遁·剑舞回天 (白色旋风气壁)"
      assetPath: "Assets/Imported/EpicToonFX/Prefabs/Combat/Sword/Whirlwind/SwordWhirlwindWhite.prefab"
      description: "周身环绕白色真空风壁，回天式剑舞防御"
      spawnOffset: {x: 0, y: 0.2, z: 0}
      spawnScale: 1
      prefab: {fileID: 1342876954156012, guid: 8243470e37cffc541978addf2dccb436, type: 3}
      motion: 0
  - categoryName: "[2] 火遁"
    themeColor: {r: 1.0, g: 0.45, b: 0.15, a: 1}
    entries:
    - title: "龙火之术 · 待吹火苗"
      assetPath: "Assets/Art/VFX/Skills/Prefabs/龙火待吹火苗.prefab"
      description: "开吹隐藏火苗，停吹复现，施术结束熄灭。"
      spawnOffset: {x: 0, y: 1, z: 0}
      spawnScale: 1
      prefab: {fileID: 100100, guid: 7ea6b7cf933b480292c703bd927081fa, type: 3}
      motion: 1
    - title: "飞炎术 · 吐火成球"
      assetPath: "Assets/Art/VFX/Skills/Prefabs/飞炎吐火球.prefab"
      description: "按 C 慢放，观察火球撞上石板后的爆散与焦痕。"
      spawnOffset: {x: 0, y: 1, z: -2.8}
      spawnScale: 1
      prefab: {fileID: 100100, guid: 6f81a414f5ce4021a071ad75333bc902, type: 3}
      motion: 2
    - title: "火遁·豪火灭却 (烈焰风暴喷涌)"
      assetPath: "Assets/Imported/MasterMagicFX/ParticlesVer2/FlameThrower/StormFlameThrower/Prefabs/StormFlameThrower.prefab"
      description: "狂暴多重火舌奔涌铺天盖地，极具斑爷豪火灭却压迫感"
      spawnOffset: {x: 0, y: 0.5, z: 0}
      spawnScale: 1
      prefab: {fileID: 8394330443960385053, guid: a136052a3cb87b447af0fb251a461d18, type: 3}
      motion: 0
    - title: "火遁·龙火之术 (火柱持续喷射)"
      assetPath: "Assets/Art/VFX/Skills/Prefabs/龙火定向喷流.prefab"
      description: "标准前方持续炽烈喷吐，火柱吞噬前方目标"
