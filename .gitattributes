# Normalize source text while leaving binary Unity resources intact.
* text=auto
*.md text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asset text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.otf binary
*.ttf binary
*.xlsx binary
*.fbx binary
